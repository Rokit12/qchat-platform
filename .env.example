DOMAIN=chat.example.com
ADMIN_EMAIL=you@example.com
# Generate each secret with:  openssl rand -base64 32
POSTGRES_PASSWORD=
REDIS_PASSWORD=
TURN_SECRET=
ADMIN_TOKEN=
IP_HASH_SECRET=
# Optional: only allow the admin dashboard from these IPs (comma-separated)
ADMIN_IPS=
# Optional: Slack/Discord/Teams-compatible webhook for high-severity security alerts
SECURITY_WEBHOOK_URL=
# Behind Cloudflare set this to cf-connecting-ip so rate limits/bans see the real client IP
TRUSTED_IP_HEADER=
