DOMAIN=chat.example.com

# ---- first admin (created on first start; you'll set up 2FA at your first sign-in at https://DOMAIN/admin) ----
ADMIN_BOOTSTRAP_USER=
ADMIN_BOOTSTRAP_PASSWORD=

# Generate EVERY secret below with:  openssl rand -base64 32     (never commit the filled-in .env)
CHAT_DB_SUPERUSER_PASSWORD=
CHAT_DB_PASSWORD=
ADMIN_DB_SUPERUSER_PASSWORD=
ADMIN_DB_PASSWORD=
REDIS_PASSWORD=
TURN_SECRET=
IP_HASH_SECRET=
# encrypts admin 2FA secrets at rest (kept outside the database)
ADMIN_SECRET_KEY=
# peppers PIN-login verifiers (kept outside the database, so a stolen DB can't be used to guess PINs)
PIN_PEPPER=

# Optional: only allow the admin dashboard from these IPs (comma-separated)
ADMIN_IPS=
# Optional: Slack/Discord/Teams-compatible webhook for security alerts and outages
SECURITY_WEBHOOK_URL=
# Behind Cloudflare set this to cf-connecting-ip so rate limits/bans see the real client IP
TRUSTED_IP_HEADER=
